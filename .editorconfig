# WordPress Coding Standards
# https://developer.wordpress.org/coding-standards/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{php,js,css,scss}]
indent_style = tab

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[composer.json]
indent_style = space
indent_size = 4
